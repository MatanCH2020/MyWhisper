# Python virtual environment (large — includes CUDA libs)
.venv/

# Python caches
__pycache__/
*.pyc
*.pyo

# User data (personal — must not be published)
history.json
history_scan_undo.json
history_scan_report.json
corrections.json
dictionary.json
english_terms.json
config.json
# OAuth credentials are normally outside the project; never publish a local copy.
*.dpapi
# Clipboard history: literally everything the user has copied. Never commit.
clips.json
clip_images/

# Logs and diagnostics
*.log
*.log.*
*_log.txt
diag*.txt

# Local tooling / scratch
.claude/
screen*.png
*_probe.py
*.tmp

# OS
Thumbs.db
desktop.ini

# Recovery files may contain private user data.
*.corrupt-*.bak
.update-backups/
.mywhisper-update.lock
test-artifacts/
/app/split_ui.py
